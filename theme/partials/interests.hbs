{{#if resume.interests.length}}
<section class="section" id="no-break-inside">
  <header>
    <h2 class='section-title'>Centres d'intérêts</h2>
  </header>
  <br>
  <section id="interests">
    {{#each resume.interests}}
    <div class="item">
      <img class="image" src="images/{{name}}.svg" title="{{name}}" height="60" />
      {{#if name}}
      <h3 class="name">
        {{name}}
      </h3>
      {{/if}}
      {{#if keywords.length}}
      <ul class="keywords">
        {{#each keywords}}
        <li>{{.}}</li>
        {{/each}}
      </ul>
      {{/if}}
      {{#if summary}}
      <div class="summary">{{paragraphSplit summary}}</div>
      {{/if}}
    </div>
    {{/each}}
  </section>
</section>
{{/if}}