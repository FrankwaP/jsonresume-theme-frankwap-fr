{{#resume.basics}}
	<header id="header" class="clear">
		{{#if image}}
		<img class="image" src="{{image}}" alt="{{name}}" />
		<div class="middle">
			<h1 class="name">{{name}}</h1>
			<h2 class="label">{{label}}</h2>
		</div>
		{{else}}
		<div>
			<h1 class="name">{{name}}</h1>
			<h2 class="label">{{label}}</h2>
		</div>
		{{/if}}

		{{#location}}
			{{#if (formatAddress address postalCode city region countryCode)}}
			<span class="location">{{formatAddress address postalCode city region countryCode}}</span>
			{{/if}}
		{{/location}}

		{{#birthDate birth}}
		{{/birthDate}}

		<div id="contact">
			{{#if website}}
			<div class="website">
				<span class="fas fa-external-link-alt"></span>
				<a class="hide-href-print" target="_blank" target="_blank" href="{{website}}">{{website}}</a>
			</div>
			{{/if}}
			{{#if email}}
			<div class="email">
				<span class="far fa-envelope"></span>
				<a class="hide-href-print" href="mailto:{{email}}">{{email}}</a>
			</div>
			{{/if}}
			{{#if phone}}
			<div class="phone">
				<span class="fas fa-mobile-alt"></span>
				<a class="hide-href-print" href="tel:{{phone}}">{{phone}}</a>
			</div>
			{{/if}}
			{{#each profiles}}
				{{#if network}}
					<div class="item">
						<div class="username">
							<span class="fab fa-{{spaceToDash network}} {{spaceToDash network}} social"></span>
							{{#if url}}
							<span class="url">
								<a target="_blank" href="{{url}}">{{url}}</a>
							</span>
							{{else}}
							<span>{{username}}</span>
							{{/if}}
						</div>
					</div>
				{{/if}}
			{{/each}}
		</div>

		
	</header>

	{{#if summary}}
	<section class="section">
		  <header>
    		<h2 class='section-title'>Résumé</h2>
  		</header>
			<div>{{summary}}</div>
	</section>
	{{/if}}

{{/resume.basics}}
